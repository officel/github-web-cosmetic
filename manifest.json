{
  "name": "GitHub Web Cosmetic",
  "description": "A simple Google Chrome extension to provide better visualization of github.com on large screen.",
  "author": "raki@officel",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "css": ["style.css"],
      "js": ["cosmetic.js"],
      "run_at": "document_idle"
    }
  ]
}
